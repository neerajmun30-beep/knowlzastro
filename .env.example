PORT=4000

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Astrology API Configuration (AstrologyAPI.com)
ASTRO_API_KEY=your-astrology-api-key-here
ASTRO_USER_ID=your-user-id-here
ASTRO_PROVIDER_URL=https://json.astrologyapi.com/v1/birth_details

# VedAstro Master Data Integration
# Optional: Connect to VedAstro.org API for advanced calculations
VEDASTRO_API_URL=https://api.vedastro.org
VEDASTRO_API_KEY=your-vedastro-api-key-here
VEDASTRO_MASTER_DATA_PATH=./VedAstro-master

# Google AI (Gemini) Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-2.0-flash

# Default timezone
DEFAULT_TIMEZONE=Asia/Kolkata
